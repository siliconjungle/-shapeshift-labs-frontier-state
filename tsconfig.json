{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "stripInternal": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "composite": true,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@shapeshift-labs/frontier": [
        "../frontier/src/index.ts"
      ],
      "@shapeshift-labs/frontier/*": [
        "../frontier/src/*.ts"
      ],
      "@shapeshift-labs/frontier-query": [
        "../frontier-query/src/index.ts"
      ],
      "@shapeshift-labs/frontier-query/*": [
        "../frontier-query/src/*.ts"
      ],
      "@shapeshift-labs/frontier-codec": [
        "../frontier-codec/src/index.ts"
      ],
      "@shapeshift-labs/frontier-codec/*": [
        "../frontier-codec/src/*.ts"
      ],
      "@shapeshift-labs/frontier-engine": [
        "../frontier-engine/src/index.ts"
      ],
      "@shapeshift-labs/frontier-engine/*": [
        "../frontier-engine/src/*.ts"
      ],
      "@shapeshift-labs/frontier-state": [
        "../frontier-state/src/index.ts"
      ],
      "@shapeshift-labs/frontier-state/*": [
        "../frontier-state/src/*.ts"
      ],
      "@shapeshift-labs/frontier-crdt": [
        "../frontier-crdt/src/index.ts"
      ],
      "@shapeshift-labs/frontier-crdt/*": [
        "../frontier-crdt/src/*.ts"
      ]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src/**/*.ts"
  ],
  "references": [
    {
      "path": "../frontier"
    },
    {
      "path": "../frontier-engine"
    }
  ]
}
